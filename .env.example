# 이 파일을 .env로 복사한 뒤 실제 값을 채우세요. .env는 절대 커밋하지 마세요.

# 에이전트 루프(app/agent_loop.py)가 OpenAI 함수 호출로 동작한다. openai 패키지가
# 이 환경변수를 자동으로 읽는다 — 코드에는 값이 등장하지 않는다.
OPENAI_API_KEY=
# 과정에서 배포한 키가 특정 모델만 허용할 수 있으니, 안 되면 콘솔에서 쓸 수 있는 모델명으로 바꿀 것.
OPENAI_MODEL=gpt-4o-mini

# Google Sheets (PRD 3.1) — kpi/detail/ytd 3개 탭만 여기 쓴다(판단 없는 고정 집계).
# 미설정 시 data/sheet_local/ 로 대신 씁니다 (개발 중 폴백 모드).
GOOGLE_SERVICE_ACCOUNT_JSON=
REPORT_SHEET_ID=

# 우리 앱 자체 DB 경로 (인사이트 초안/승인 상태). 기본값을 쓰면 이 줄은 없어도 됨.
APP_DB_PATH=

# 에이전트 루프 종료 조건 (PRD 4.3)
MAX_REQUERY_ROUNDS=5
RUN_TIME_LIMIT_SECONDS=180

# 이상치 탐지 기본값 (PRD 4.2.1)
DEFAULT_SIGMA_MULTIPLIER=2
DEFAULT_BASELINE_PERIODS=12
